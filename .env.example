# Server-only secret used by BuildMyLogic's AI coach (Sarvam AI)
SARVAM_API_KEY=sk_your_sarvam_api_key

# Supabase PostgreSQL Cloud Memory & Auth
# Get these from your Supabase dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Server-only. Never expose this key to the browser or VS Code extension.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Optional comma-separated origins allowed to call the session API from another site.
# Same-origin calls and non-browser clients do not need this.
ALLOWED_ORIGINS=
