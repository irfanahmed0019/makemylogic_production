# Copy to .env in the workspace root. Do not commit the real values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SARVAM_API_KEY=sk_your-sarvam-key

# These are intentionally not used by the VS Code extension. They belong in a
# trusted server only, never in an extension bundle or a committed .env file.
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SESSION_SECRET=
